rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Public profile + per-user library. Any signed-in user can read (so
    // friends can see profiles and shelves); only the owner can write.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid);
      allow delete: if false;

      match /shelves/{shelfId} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      match /books/{bookId} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      // Users this user follows.
      match /following/{otherUid} {
        allow read: if signedIn();
        allow write: if isOwner(uid);
      }

      // Notifications are written by other users (e.g. "X followed you"),
      // but only the owner can read or clear them.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if signedIn() && request.resource.data.fromUid == request.auth.uid;
      }
    }

    // One chat document per pair of users; id = the two uids sorted and joined.
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.participants;
      allow create: if signedIn() && request.auth.uid in request.resource.data.participants;
      allow update: if signedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update, delete: if false;
      }
    }
  }
}
